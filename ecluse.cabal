executable ecluse
  import:         shared
  -- This executable needs the threaded runtime. With telemetry enabled, the
  -- OpenTelemetry SDK runs a batch span processor on a background thread, which aborts
  -- under the non-threaded RTS. The -N flag lets the server and worker use every core.
  --
  -- The -A64m -n4m pair tunes the GC for the serve path's allocation profile.
  -- Assembling and re-serialising a many-version packument allocates tens of MB per
  -- request. The default 4 MB allocation area then makes the process collect hundreds
  -- of times a second under load. GC took about half the wall time in the load
  -- benchmarks. A 64 MB per-capability allocation area, divided into 4 MB chunks, cuts
  -- the collection count by an order of magnitude. The chunks let capabilities share
  -- the area instead of stranding idle nurseries. An operator can override it at run
  -- time, `ecluse +RTS -A16m -RTS` for example, because -rtsopts is set. See
  -- https://ecluse-proxy.com/docs/operations/.
  ghc-options:    -threaded -rtsopts "-with-rtsopts=-N -A64m -n4m"
  main-is:        Main.hs
  hs-source-dirs: app
  build-depends:  ecluse

-- The OpenAPI spec assembly: the pure (ManifestSource -> OpenApi) builder and
-- the owned schemas. An INTERNAL sublibrary, following the ecluse-test-support
-- pattern. That keeps the heavy OpenAPI dependency tree (openapi3, autodocodec, lens,
-- optics, and the rest) OUT of the shipped `library ecluse` and `executable ecluse`
-- closure. Only the openapi-gen generator and the ecluse-unit test suite depend on it,
-- never the app library. It links ecluse-core, for the Route enumeration and the
-- served types, not the app library.
library ecluse-manifest
  import:          shared
  hs-source-dirs:  manifest
  exposed-modules: Ecluse.Manifest
  build-depends:
    , ecluse:ecluse-core
    , aeson                      >=2.2 && <2.4
    , aeson-pretty               ^>=0.8
    , autodocodec                ^>=0.5
    , autodocodec-openapi3       ^>=0.3
    , http-media                 ^>=0.8
    , http-types                 ^>=0.12
    , insert-ordered-containers  ^>=0.2
    , openapi3                   ^>=3.2
    , text                       ^>=2.1

-- The OpenAPI spec generator: a build-time component that assembles the
-- OpenAPI document (Ecluse.Manifest) from the fixed canonical source and writes
-- the committed openapi.json. It depends on the ecluse-manifest sublibrary, NOT the
-- app library, so the OpenAPI dependency tree never reaches the running proxy. Run
-- with `cabal run openapi-gen`.
executable openapi-gen
  import:         shared
  main-is:        Main.hs
  hs-source-dirs: gen
  build-depends:
    , directory          ^>=1.3
    , ecluse:ecluse-manifest
    , filepath           ^>=1.5

-- The site page renderers: the PURE Markdown rendering behind the site-gen
-- executable. It turns the OWASP Threat Dragon model into the threat register, and an
-- OpenAPI document into the static API reference. An INTERNAL sublibrary, following
-- the ecluse-manifest pattern, so the gating unit suite exercises the rendering
-- deterministically. It reads no file and holds no OpenAPI assembly, so it links
-- neither the app library nor ecluse-manifest, and it stays out of the shipped
-- library closure.
library ecluse-site
  import:          shared
  hs-source-dirs:  site/src
  exposed-modules:
    Ecluse.Site.Markdown
