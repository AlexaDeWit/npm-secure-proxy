    Ecluse.E2E.Fixtures
    Ecluse.E2E.Harness
    Ecluse.E2E.Harness.Docker
    Ecluse.E2E.Harness.Npm
    Ecluse.E2E.Harness.Proxy
    Ecluse.E2E.Harness.Types
    Ecluse.E2E.Harness.Verdaccio
    Ecluse.E2ESpec
    Ecluse.Test.SupportLinkageE2ESpec

  build-tool-depends: hspec-discover:hspec-discover ^>=2.11
  build-depends:
    , aeson          >=2.2 && <2.4
    , bytestring     ^>=0.12
    , containers     ^>=0.7
    , directory      ^>=1.3
    , ecluse:ecluse-core
    , ecluse:ecluse-test-support
    , filepath       ^>=1.5
    , hspec          ^>=2.11
    , http-client    ^>=0.7
    , http-types     ^>=0.12
    , network        ^>=3.2
    , text           ^>=2.1
    , time           ^>=1.12
    , typed-process  ^>=0.2.13
    , unliftio       ^>=0.2.25

-- Benchmarks: the work-per-request micro-benches over the pure ecluse-core hot paths,
-- plus the synthetic-corpus generator's correctness tests and the complexity
-- assertions that guard the accidentally-quadratic class. The harness is tasty-bench
-- rather than criterion, because it reports time AND allocations. Allocations are the
-- machine-independent signal, captured from GC stats under +RTS -T, baked in below.
-- It links ecluse:ecluse-core and ecluse:ecluse-test-support, and stays OUT of the
-- library's own dependency closure.
benchmark ecluse-bench
  import:          shared
  type:            exitcode-stdio-1.0
  main-is:         Main.hs
  hs-source-dirs:  bench
  -- Built at the package's default optimisation (-O1), like every other component,
  -- so the numbers reflect the shipped build rather than a benchmark-only setting.
  -- The RTS opts bake in -T, so tasty-bench reports allocated bytes from GC stats on
  -- every run, with no caller flag.
  ghc-options:     -rtsopts "-with-rtsopts=-T"
  other-modules:
    Ecluse.Bench.Corpus
    Ecluse.Bench.Fit
    Ecluse.Core.MergeBench
    Ecluse.Core.RouteBench
    Ecluse.Core.RulesBench
    Ecluse.Core.SecurityBench
    Ecluse.Core.SelectiveBench
    Ecluse.Core.ServeBench
    Ecluse.Core.StreamBench
    Ecluse.Core.VersionBench
    Ecluse.Core.WireBench

  build-depends:
    , ecluse:ecluse-core
    , ecluse:ecluse-test-support
    , aeson            >=2.2 && <2.4
    , bytestring       ^>=0.12
    , containers       ^>=0.7
    , http-types       ^>=0.12
    , tasty            ^>=1.5
    , tasty-bench      ^>=0.4
    , tasty-bench-fit  ^>=0.1
    , tasty-hunit      ^>=0.10
    , text             ^>=2.1
    , time             ^>=1.12

-- Load benchmarks harness: throughput and latency under concurrent load against the
-- real composed proxy. A separate EXECUTABLE rather than a tasty-bench component. It
-- boots Ecluse.Server.application on warp over in-process stub upstreams and the
-- in-memory queue and credential doubles. It drives the HTTP scenarios with `oha`, a
-- subprocess run through typed-process, and the worker scenario in-process. It captures
-- RTS stats (peak residency, GC pauses, allocations per request). So it needs the
-- threaded RTS (-threaded, for real warp and concurrency), -N for every core, and -T
-- baked in (GHC.Stats). It links the `ecluse` app library for the composed Application,
-- and stays out of the library closure. INFORM-ONLY and not part of the gate.
executable bench-load
  import:          shared
  main-is:         Main.hs
  hs-source-dirs:  bench/load

  -- The load harness drives in-process plain-http stub registries, so it needs the
  -- flag-gated loopback egress former (Ecluse.Core.Security.Egress.DevHttp). A
  -- release-posture build has the flag off, the Nix docs and Haddock check included.
  -- It carries no such module by design, so this dev-only tool does not build there.
  if !flag(dev-http-egress)
    buildable: False
  -- Mirrors the shipped server's RTS tuning (-A64m -n4m, see `executable ecluse`), so
  -- the load benchmarks measure the runtime posture the proxy ships with. The -T flag
  -- also exposes the RTS stats the harness reports.
  ghc-options:     -threaded -rtsopts "-with-rtsopts=-T -N -A64m -n4m"
  other-modules:
    Ecluse.BenchLoad.Error
    Ecluse.BenchLoad.Harness
    Ecluse.BenchLoad.Npm
    Ecluse.BenchLoad.Oha

  build-depends:
    , ecluse
    , ecluse:ecluse-bench-load
    , ecluse:ecluse-core
    , ecluse:ecluse-runtime
    , ecluse:ecluse-test-support
    , ecluse:ecluse-runtime-test-support
    , aeson            >=2.2 && <2.4
    , bytestring       ^>=0.12
    , containers       ^>=0.7
    , http-client      ^>=0.7
    , http-client-tls  >=0.3.6 && <0.5
    , http-types       ^>=0.12
    , iproute          ^>=1.7
    , katip            ^>=0.8.8
    , text             ^>=2.1
    , time             ^>=1.12
    , typed-process    ^>=0.2.13
    , unliftio         ^>=0.2.25
    , wai              ^>=3.2
    , warp             ^>=3.4

-- Load benchmarks normalisation core: the PURE attribution and saturation maths behind
-- the load harness's two analysis views. Those views are the service-time split of
-- upstream against overhead, and the load-saturation queuing-delay flag. An INTERNAL
-- sublibrary, following the ecluse-acceptance pattern, so the gating unit suite tests
-- the maths deterministically. The live RTT probe and the two-pass orchestration stay
-- in the bench-load executable. Carries no socket or load-generator dependency.
library ecluse-bench-load
  import:          shared
  hs-source-dirs:  bench/load/src
  exposed-modules: Ecluse.BenchLoad.Normalise
  build-depends:   text ^>=2.1

-- Work-per-request bench report core: the PURE CSV-to-Markdown rendering behind the
-- bench run summary (parse the tasty-bench CSV, group by tasty path, render the
-- structured report). An INTERNAL sublibrary, following the ecluse-bench-load pattern,
-- so the gating unit suite exercises the parse and rendering deterministically. No HTTP
-- and no egress former, so unlike bench-load it needs no dev-http-egress gating. It
-- stays out of the shipped library closure.
library ecluse-bench-report
  import:          shared
  hs-source-dirs:  bench/report/src
  exposed-modules: Ecluse.BenchReport
  build-depends:   text ^>=2.1

-- The bench report renderer: the thin file-reading shell over ecluse-bench-report.
-- CI runs it after the benchmarks to turn bench-results.csv, plus the teed console
-- output, into the run summary. It appends to $GITHUB_STEP_SUMMARY itself, like the
-- load and acceptance harnesses, so the workflow step stays a single unwrapped
-- command.
executable bench-report
  import:         shared
  main-is:        Main.hs
  hs-source-dirs: bench/report
  build-depends:
    , ecluse:ecluse-bench-report
    , text  ^>=2.1

-- Live performance-acceptance harness: the PURE evaluation core. The
-- version-controlled acceptance criteria, the per-package budget verdict, and the
-- run-summary rendering. An INTERNAL sublibrary, following the ecluse-manifest pattern,
-- so the gating unit suite can test the acceptance decision deterministically. The live
-- fetch and timing stay in the perf-acceptance executable. Links ecluse-core only, and
-- stays out of the shipped library closure.
library ecluse-acceptance
  import:          shared
  hs-source-dirs:  acceptance/src
  exposed-modules: Ecluse.Acceptance
  build-depends:
    , ecluse:ecluse-core
    , aeson       >=2.2 && <2.4
    , bytestring  ^>=0.12
    , containers  ^>=0.7
    , text        ^>=2.1

-- The live performance-acceptance harness: a separate EXECUTABLE. It fetches LIVE
-- packuments for the curated catalogue set (Ecluse.Test.RegistryCapture), times
-- Écluse's work-per-request over each, and evaluates the overhead against the
-- version-controlled budget (ecluse-acceptance). It runs on demand, on a schedule, and
-- per PR, and it NEVER gates a PR. A budget breach reds the non-required check to
-- inform a human decision, and never blocks the merge. Kept out of the shipped library
-- closure.
executable perf-acceptance
  import:         shared
  main-is:        Main.hs
  hs-source-dirs: acceptance/app
  build-depends:
    , ecluse:ecluse-acceptance
    , ecluse:ecluse-core
    , ecluse:ecluse-test-support
    , aeson            >=2.2 && <2.4
    , bytestring       ^>=0.12
    , containers       ^>=0.7
    , http-client      ^>=0.7
    , http-client-tls  >=0.3.6 && <0.5
    , text             ^>=2.1
    , time             ^>=1.12
