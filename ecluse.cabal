cabal-version: 3.0
name:          ecluse
version:       0.4.0
synopsis:      Supply-chain resilience proxy for package registries
description:
  Écluse is a controlled passage in front of package registries (npm, PyPI, …).
  Every dependency clears resilience and policy checks (version and age gates,
  rule-based allow/deny) before it reaches your build. See the README for the
  architecture and configuration.
homepage:      https://github.com/AlexaDeWit/Ecluse
license:       MIT
license-file:  LICENSE
author:        Alexandra DeWit
maintainer:    https://github.com/AlexaDeWit
category:      Network, Security
build-type:    Simple

-- Test fixtures the pure unit suite reads at run time. The version-ordering file is
-- reference-oracle output. Regenerate it with `task gen-version-fixtures`. The
-- `npm/*.json` bodies are live captures of registry.npmjs.org, and
-- Ecluse.Registry.Npm.Wire decodes them.
-- `express.full.json` is a real, untrimmed capture of a large trusted package's full
-- packument (registry.npmjs.org/express). A test can then prove that the
-- response-bound defaults do not false-positive on a legitimate large package.
--
-- `bench/corpus/npm/*.json` is the curated real-world packument corpus the benchmarks
-- read at run time. The corpus stays frozen, pinned by `bench/corpus/pins.json` and
-- re-captured deliberately with `task gen-bench-corpus`. `bench/corpus/pins.json` is
-- the shared registry catalogue, holding the capture pins and the smoke curated names,
-- read by the Node capture script and Ecluse.Test.RegistryCapture.
-- `acceptance/criteria.json` is the version-controlled acceptance budget for the live
-- performance-acceptance harness (Ecluse.Acceptance and the perf-acceptance executable).
-- `test/unit/fixtures/epss/*.gz` is a gzipped slice of the EPSS feed, keyed to the CVE
-- aliases the OSV corpus carries, so the compile-time join has a deterministic input.
extra-source-files:
  acceptance/criteria.json
  bench/corpus/npm/*.json
  bench/corpus/pins.json
  core/test/unit/fixtures/npm/*.json
  core/test/unit/fixtures/version-ordering.txt
  test/fixtures/osv/v1/*.json
  test/fixtures/osv/v2/*.json
  test/unit/fixtures/epss/*.gz
  test/unit/fixtures/osv/*.zip

source-repository head
  type:     git
  location: https://github.com/AlexaDeWit/Ecluse.git

-- Compile the test- and dev-only plain-HTTP loopback egress constructor
-- (Ecluse.Core.Security.Egress.DevHttp). OFF by default, so the release library and
-- executable carry no way to construct a non-https registry target. The dev shell and
-- the test and CI builds turn it ON, so the loopback integration suites compile.
-- `cabal.project` enables it for `cabal` in the dev shell, and the flake's unit-core
-- and unit-app checks pass -fdev-http-egress. The Nix-built release `ecluse` leaves
-- it off, because callCabal2nix ignores cabal.project and takes this default.
flag dev-http-egress
  description: Expose the test-only plain-HTTP loopback egress constructor.
  default:     False
  manual:      True

-- Shared settings for every component. relude replaces the default prelude via
-- cabal mixins (see docs/architecture.md "relude as the implicit prelude").
common shared
  -- Warning set: -Wall plus extra warnings that reinforce the conventions in
  -- STYLE.md. cabal.project promotes a warning to an error for our own package.
  -- Deliberately omitted: -Wunused-packages (the relude mixin defeats its attribution,
  -- see docs/architecture.md), -Wmissing-import-lists (open imports for internal
  -- modules), and -Wmissing-local-signatures (a where-helper may stay inferred).
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-selectors
    -Wincomplete-record-updates -Wincomplete-uni-patterns
    -Wmissing-deriving-strategies -Wmissing-export-lists -Wname-shadowing
    -Wpartial-fields -Wredundant-bang-patterns -Wredundant-constraints

  default-language:   GHC2021
  default-extensions:
    DerivingStrategies
    LambdaCase
    OverloadedStrings
    StrictData

  build-depends:
    , base        ^>=4.20
    , file-embed  ^>=0.0.16
    , relude      ^>=1.2

  mixins:
    base hiding (Prelude),
    relude (Relude as Prelude)

